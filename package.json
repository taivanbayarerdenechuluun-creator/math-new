    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "database/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.15",
    "katex": "^0.16.47",
    "lucide-react": "^1.68.0",
    "mathjs": "^14.9.1",
    "mathlive": "^0.111.4",
    "next": "^15.5.29",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^5.5.7",
    "recharts": "^2.15.4",

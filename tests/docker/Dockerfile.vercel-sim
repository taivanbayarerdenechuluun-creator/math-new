# Vercel-ийн build-ийг локалд дуурайх (VERCEL=1, PostgreSQL, production seed).
# Ашиглах: docker compose -f docker-compose.yml -f tests/docker/vercel-sim.yml up --build vtest
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY database/schema.prisma database/schema.prisma
RUN npm ci
COPY . .
CMD ["sh", "-c", "node scripts/vercel-build.mjs && npx next start -p 3000"]

# --- Өгөгдлийн сан ---
# Хөгжүүлэлт: SQLite (нэмэлт суулгац шаардлагагүй)
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL/Supabase ашиглах бол database/schema.prisma доторх provider-ийг "postgresql" болгоод:
# DATABASE_URL="postgresql://user:pass@host:5432/iqmath"

# --- Нэвтрэлт ---
# Хамгийн багадаа 32 тэмдэгт бүхий санамсаргүй нууц үг
AUTH_SECRET="replace-with-long-random-secret"

# --- AI (Claude) --- хоосон бол AI функцууд "тохируулаагүй" гэж харагдана
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# --- Математик OCR (Mathpix) --- хоосон бол Claude vision fallback ашиглана
MATHPIX_APP_ID=""
MATHPIX_APP_KEY=""

# --- Файл хадгалалт ---
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_MB="10"
